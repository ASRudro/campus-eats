# ==========================================
# CampusEats Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuseats

# Database Driver: 'mysql' (default) or 'sqlite' (embedded fallback)
DB_DRIVER=mysql
DB_FALLBACK=true

# JWT Secret Key for Authentication
JWT_SECRET=campuseats_university_jwt_super_secret_key_2026

# Cloudinary External Cloud Image Storage (Optional)
# If left empty, high-resolution CDN images with automatic fallbacks are used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
