# ==========================================
# CampusEats Root Configuration Template
# ==========================================

PORT=5000
NODE_ENV=development

# MySQL Database Connection (XAMPP / MySQL Server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuseats

# Database Driver: 'mysql' (default) or 'sqlite' (embedded fallback)
DB_DRIVER=mysql

# JWT Authentication Secret
JWT_SECRET=campuseats_university_jwt_super_secret_key_2026

# External Cloud Image Storage (Cloudinary - Optional)
# If left blank, CDN food imagery with automatic error fallbacks is utilized.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
